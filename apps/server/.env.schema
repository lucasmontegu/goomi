# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=if($VERCEL_ORIGIN, "${VERCEL_ORIGIN}/api/auth", undefined)

# @type=url
CORS_ORIGIN=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# ---
# Social sign-in (native iOS). All optional: a provider is only enabled when its IDs are set.

# Sign in with Apple — native iOS id tokens carry the app's bundle ID as `aud`.
# Required to enable Apple sign-in from the Goomi iOS app (e.g. com.yourco.goomi).
# @optional @sensitive=false @type=string
APPLE_APP_BUNDLE_IDENTIFIER=

# Apple Services ID — only needed for the web redirect flow. Also accepted as an id-token audience.
# @optional @sensitive=false @type=string
APPLE_CLIENT_ID=

# Apple client secret (ES256 JWT signed with your Sign in with Apple .p8 key, max 6 months).
# Only needed for the web redirect flow; native id-token sign-in does not use it.
# @optional @type=string
APPLE_CLIENT_SECRET=

# Google OAuth "Web application" client ID. The iOS app passes it as webClientId, so Google
# issues id tokens with this value as `aud`. Required to enable Google sign-in.
# @optional @sensitive=false @type=string
GOOGLE_CLIENT_ID=

# Google OAuth "iOS" client ID. Accepted as an additional id-token audience.
# @optional @sensitive=false @type=string
GOOGLE_IOS_CLIENT_ID=

# Google web client secret — only needed for the web redirect flow.
# @optional @type=string
GOOGLE_CLIENT_SECRET=

# ---
# Dynamic content & AI study (docs/goomi/ai-content-architecture.md). All optional: study AI
# stays off until STUDY_AI_ENABLED=true and the Gateway + RevenueCat keys are present.

# Kill switch for AI document processing (uploads are refused with `study.disabled` when false).
# @optional @sensitive=false @type=boolean
STUDY_AI_ENABLED=false

# Vercel AI Gateway key for local development. On Vercel, OIDC (VERCEL_OIDC_TOKEN) is used instead.
# @optional @type=string
AI_GATEWAY_API_KEY=

# How document-derived AI calls are routed. `zdr` = zero-data-retention providers only (requires a
# Vercel Pro/Enterprise team); `no-training` = providers that don't train on prompts (weaker).
# @optional @sensitive=false @type=enum(zdr, no-training)
AI_DOCUMENT_PRIVACY=zdr

# RevenueCat v2 secret key with customer_information:customers:read. Without it, Plus can't be verified
# and study uploads fail closed.
# @optional @type=string
REVENUECAT_SECRET_KEY=

# @optional @sensitive=false @type=string
REVENUECAT_PROJECT_ID=projbda3341e

# Internal id of the `goomi_pro` entitlement (v2 API returns ids, not lookup keys).
# @optional @sensitive=false @type=string
REVENUECAT_ENTITLEMENT_ID=entl481993caba

# Value RevenueCat sends in the webhook Authorization header (set in the RevenueCat dashboard).
# @optional @type=string(minLength=24)
REVENUECAT_WEBHOOK_AUTH=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
# @optional @type=string(minLength=24)
CRON_SECRET=

# Shared secret for the job runner re-invoking itself.
# @optional @type=string(minLength=32)
JOBS_SECRET=

# Descriptive agent with contact details, required by Wikimedia/AIC for the weekly fact fetch.
# @optional @sensitive=false @type=string
CONTENT_USER_AGENT=
