# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=string(matches="^(https?://|/(?!/))")
EXPO_PUBLIC_SERVER_URL=

# RevenueCat public SDK key. `test_…` = RevenueCat Test Store (simulator, no App Store); `appl_…` = App Store.
# @public @optional @type=string
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# @public @optional @type=string
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog project key. Analytics stays off unless the user opts in.
# @public @optional @type=string
EXPO_PUBLIC_POSTHOG_KEY=
