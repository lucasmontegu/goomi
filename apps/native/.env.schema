# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=string(matches="^(https?://|/(?!/))")
EXPO_PUBLIC_SERVER_URL=

# RevenueCat public SDK key. `test_…` = RevenueCat Test Store (simulator, no App Store); `appl_…` = App Store.
# @public @optional @type=string
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# @public @optional @type=string
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog project key. Analytics stays off unless the user opts in.
# @public @optional @type=string
EXPO_PUBLIC_POSTHOG_KEY=

# Google OAuth "iOS" client ID (…apps.googleusercontent.com). Enables "Continue with Google" and,
# at prebuild time, the reversed-client-ID URL scheme the Google SDK needs. Rebuild after changing.
# @public @optional @type=string
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google OAuth "Web application" client ID. Google issues the id token for this audience;
# the server's GOOGLE_CLIENT_ID must be the same value.
# @public @optional @type=string
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
