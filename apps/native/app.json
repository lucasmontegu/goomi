{
  "expo": {
    "name": "Goomi",
    "slug": "goomi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/goomi/app-icon.png",
    "scheme": "goomi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.goomi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Goomi reads the images you choose so it can turn your notes and slides into recall prompts.",
        "NSCameraUsageDescription": "Take a photo of your notes so Goomi can turn them into recall prompts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D9FF6B",
        "foregroundImage": "./assets/goomi/android-foreground.png",
        "backgroundImage": "./assets/goomi/android-background.png",
        "monochromeImage": "./assets/goomi/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.goomi"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/goomi/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/goomi/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF8",
          "dark": {
            "image": "./assets/goomi/splash.png",
            "backgroundColor": "#0F0F10"
          }
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.4"
          }
        }
      ],
      [
        "./plugins/with-goomi-screen-time",
        {
          "mascotImage": "./assets/goomi/poses/wave.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FAFAF8"
  }
}
