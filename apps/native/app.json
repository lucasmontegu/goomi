{
  "expo": {
    "name": "Goomi",
    "slug": "goomi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/goomi/app-icon.png",
    "scheme": "goomi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumlabs.goomi",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Goomi reads the images you choose so it can turn your notes and slides into recall prompts.",
        "NSCameraUsageDescription": "Take a photo of your notes so Goomi can turn them into recall prompts."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D9FF6B",
        "foregroundImage": "./assets/goomi/android-foreground.png",
        "backgroundImage": "./assets/goomi/android-background.png",
        "monochromeImage": "./assets/goomi/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lumlabs.goomi"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/goomi/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/goomi/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF8",
          "dark": {
            "image": "./assets/goomi/splash.png",
            "backgroundColor": "#0F0F10"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9FF6B"
        }
      ],
      "expo-image",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.4"
          }
        }
      ],
      [
        "./plugins/with-goomi-screen-time",
        {
          "mascotImage": "./assets/goomi/poses/wave.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FAFAF8",
    "owner": "lumlabs",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "googleSignInNative": false,
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "GoomiActivityMonitor",
                  "bundleIdentifier": "com.lumlabs.goomi.GoomiActivityMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.lumlabs.goomi.screentime"
                    ]
                  }
                },
                {
                  "targetName": "GoomiShieldAction",
                  "bundleIdentifier": "com.lumlabs.goomi.GoomiShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.lumlabs.goomi.screentime"
                    ]
                  }
                },
                {
                  "targetName": "GoomiShieldConfiguration",
                  "bundleIdentifier": "com.lumlabs.goomi.GoomiShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.lumlabs.goomi.screentime"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "dbb1cf0e-c9d4-42ed-bcaf-36d737b85c60"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/dbb1cf0e-c9d4-42ed-bcaf-36d737b85c60",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
