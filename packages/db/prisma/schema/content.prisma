// Dynamic content system — ADR-001 (docs/goomi/ai-content-architecture.md).
// `userId` columns deliberately have no Prisma relation to `User`: auth.prisma is regenerated by
// Better Auth. Account deletion calls `purgeUserContent` (packages/db/src/content.ts) instead.
// Vector columns and HNSW indexes live in raw migration SQL (Prisma 7 has no vector type).

enum BankItemStatus {
  draft
  published
  rejected
  retired
}

enum MaterialStatus {
  queued
  processing
  ready
  failed
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum StudyKind {
  application
  compare
  cause_effect
  ordering
  cloze
  error_spot
  synthesis
}

/// Raw open-data facts with their license, refreshed by the weekly fetch job.
model ContentFact {
  id           String   @id @default(cuid())
  sourceId     String
  /// The generator's fact id (e.g. "Q414", "aic-28560"), which BankItem.factIds reference.
  sourceItemId String
  kind         String
  payload      Json
  hash         String
  retrievedAt  DateTime
  updatedAt    DateTime @updatedAt

  @@unique([sourceId, sourceItemId, kind])
  @@map("content_fact")
}

/// Language-independent challenge skeleton; id = bankItemId(templateId, factIds), stable across rebuilds.
model BankItem {
  id          String           @id
  templateId  String
  topicId     String
  type        String
  difficulty  String
  conceptKey  String
  factIds     String[]
  status      BankItemStatus   @default(draft)
  version     Int              @default(1)
  attribution Json
  media       Json?
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  locales     BankItemLocale[]

  @@index([status, updatedAt])
  @@map("bank_item")
}

model BankItemLocale {
  itemId     String
  lang       String
  challenge  Json
  /// Hash of the templated challenge; enrichment is kept until the template output changes.
  baseHash   String?
  enrichedBy String?
  judge      Json?
  status     BankItemStatus @default(draft)
  /// Monotonic sync cursor: bumped on every publish/retire so devices fetch only changes.
  seq        BigInt         @default(autoincrement())
  updatedAt  DateTime       @updatedAt
  item       BankItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, lang])
  @@unique([seq])
  @@index([lang, status, seq])
  @@map("bank_item_locale")
}

model Material {
  id             String            @id @default(cuid())
  userId         String
  title          String
  kind           String
  /// Detected language of the notes; study questions are written in it (ADR-001 Q2).
  lang           String?
  status         MaterialStatus    @default(queued)
  pageCount      Int
  charCount      Int
  textHash       String
  consentVersion String
  consentedAt    DateTime
  progress       Json?
  error          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  pages          MaterialPage[]
  sections       MaterialSection[]
  chunks         Chunk[]
  challenges     StudyChallenge[]
  jobs           Job[]

  @@unique([userId, textHash])
  @@index([userId, createdAt])
  @@map("material")
}

model MaterialPage {
  materialId String
  n          Int
  text       String
  /// "device" (on-device OCR/PDFKit) or "ai-ocr" (vision fallback).
  source     String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([materialId, n])
  @@map("material_page")
}

model MaterialSection {
  id         String   @id @default(cuid())
  materialId String
  index      Int
  heading    String?
  pageStart  Int
  pageEnd    Int
  tokenCount Int
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, index])
  @@map("material_section")
}

model Chunk {
  id             String                         @id @default(cuid())
  materialId     String
  userId         String
  sectionIndex   Int
  index          Int
  text           String
  pageStart      Int
  pageEnd        Int
  paragraphStart Int
  paragraphEnd   Int
  charStart      Int
  charEnd        Int
  tokenCount     Int
  /// qwen3-embedding-8b truncated to 1024 dims (MRL), L2-normalized. Written with $executeRaw.
  embedding      Unsupported("halfvec(1024)")?
  material       Material                       @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, index])
  @@index([userId])
  @@map("chunk")
}

/// Per-user concept graph node, deduplicated across that user's uploads.
model Concept {
  id         String                        @id @default(cuid())
  userId     String
  name       String
  definition String
  aliases    String[]
  lang       String?
  embedding  Unsupported("halfvec(1024)")?
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt
  mentions   ConceptMention[]
  edgesFrom  ConceptEdge[]                 @relation("edgeFrom")
  edgesTo    ConceptEdge[]                 @relation("edgeTo")

  @@index([userId])
  @@map("concept")
}

model ConceptMention {
  conceptId  String
  chunkId    String
  materialId String
  quote      String
  concept    Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([conceptId, chunkId])
  @@index([materialId])
  @@map("concept_mention")
}

model ConceptEdge {
  fromId   String
  toId     String
  /// related | prerequisite | part_of | contrasts | causes
  relation String
  weight   Float
  /// vector | llm
  origin   String
  from     Concept @relation("edgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to       Concept @relation("edgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId, relation])
  @@index([toId])
  @@map("concept_edge")
}

model StudyChallenge {
  id           String    @id @default(cuid())
  materialId   String
  userId       String
  /// Idempotency key within a material (stage retries upsert on it).
  candidateKey String
  kind         StudyKind
  lang         String
  conceptIds   String[]
  chunkIds     String[]
  challenge    Json
  judge        Json?
  accepted     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  material     Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, candidateKey])
  @@index([userId])
  @@map("study_challenge")
}

model Job {
  id             String    @id @default(cuid())
  /// material.process | bank.fetch | bank.build | bank.enrich
  kind           String
  materialId     String?
  userId         String?
  stage          String
  status         JobStatus @default(queued)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  lockedUntil    DateTime  @default(now())
  runAfter       DateTime  @default(now())
  idempotencyKey String    @unique
  progress       Json?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  material       Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([materialId])
  @@map("job")
}

/// One row per AI call; costUsd starts as a price-table estimate and is reconciled from the Gateway.
model AiUsage {
  id              String   @id @default(cuid())
  userId          String?
  jobId           String?
  materialId      String?
  purpose         String
  model           String
  inputTokens     Int
  outputTokens    Int
  reasoningTokens Int      @default(0)
  costUsd         Decimal? @db.Decimal(12, 6)
  /// estimate | gateway
  costSource      String
  generationId    String?
  zdr             Boolean
  latencyMs       Int
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([costSource, createdAt])
  @@map("ai_usage")
}

/// Cached RevenueCat entitlement per Better Auth user (app_user_id == user.id).
model Entitlement {
  userId        String    @id
  entitlementId String
  active        Boolean
  expiresAt     DateTime?
  environment   String
  /// webhook | rest
  source        String
  updatedAt     DateTime  @updatedAt

  @@map("entitlement")
}

/// Webhook de-duplication: RevenueCat delivers at least once with a stable event id.
model RevenueCatEvent {
  id         String   @id
  type       String
  appUserId  String
  receivedAt DateTime @default(now())

  @@map("revenuecat_event")
}

model UsageCounter {
  /// Better Auth user id, or "install:<id>" for anonymous devices.
  subject String
  /// "2026-09" (monthly) or "2026-09-23" (daily)
  period  String
  metric  String
  value   Float  @default(0)

  @@id([subject, period, metric])
  @@map("usage_counter")
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limit_bucket")
}
